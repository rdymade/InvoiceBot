## Required Configuration

# Discord Bot Token - Get from Discord Developer Portal
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Google Sheets Spreadsheet ID - Found in the URL of your sheet
# Example: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID="YOUR_SPREADSHEET_ID_HERE"

# Sheet name for invoice command
INVOICE_SHEET_NAME="Farm_list"

# Cell range for invoice command
INVOICE_RANGE="E2:L"

# Allowed Discord user IDs, comma-separated
ALLOWED_USER_IDS="YOUR_DISCORD_USER_ID_1,YOUR_DISCORD_USER_ID_2"

## Optional Configuration

# Path to your Google Service Account credentials JSON file
#GOOGLE_CREDENTIALS_PATH="/app/credentials.json"

# Command prefix for bot commands
#COMMAND_PREFIX="!"
