# Environment Configuration Template

Copy this file to `.env` and fill in your values, then source it before running the bot.

## Required Configuration

# Discord Bot Token - Get from Discord Developer Portal
export DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Google Sheets Spreadsheet ID - Found in the URL of your sheet
# Example: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
export SPREADSHEET_ID="YOUR_SPREADSHEET_ID_HERE"

## Optional Configuration

# Path to your Google Service Account credentials JSON file
# Default: ./credentials.json
export GOOGLE_CREDENTIALS_PATH="./credentials.json"

# Command prefix for bot commands
# Default: !
export COMMAND_PREFIX="!"

# Allowed Discord user IDs, comma-separated
# Example: 123456789012345678,987654321098765432
export ALLOWED_USER_IDS="YOUR_DISCORD_USER_ID_1,YOUR_DISCORD_USER_ID_2"

## Usage

# On Linux/Mac:
source .env

# On Windows (PowerShell):
# $env:DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN"
# $env:SPREADSHEET_ID="YOUR_SPREADSHEET_ID"
# $env:GOOGLE_CREDENTIALS_PATH="./credentials.json"
# $env:COMMAND_PREFIX="!"
